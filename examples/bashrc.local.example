# .bashrc machine context. Copy to ~/.bashrc.local and fill in.
# This file is machine-specific and MUST NOT be committed to this repo.
# It is sourced at the end of ~/.bashrc, so it can override shared defaults.

# Machine-only PATH entries (e.g. a work toolchain)
# export PATH="/some/machine/only/bin:${PATH}"

# Machine-only perl libs, etc.
# export PERL5LIB="$PERL5LIB:/some/machine/only/lib"
