# -*- shell-script -*-
# Machine context for zsh. Copy to ~/.zshrc.local and fill in.
# This file is machine-specific and MUST NOT be committed to this repo.
# It is sourced at the end of ~/.zshrc, so it can override shared defaults.

# Nexus credentials
# export NEXUS_USERNAME=
# export NEXUS_PASSWORD=

# Google Cloud
# export GOOGLE_CLOUD_PROJECT=

# Machine-only PATH entries (e.g. a work toolchain)
# export PATH="/some/machine/only/bin:${PATH}"
