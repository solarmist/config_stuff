#!/usr/bin/env bash

export CLICOLOR=1 # Colorize Mac OS

# Put pip --user console scripts on PATH. The macOS framework Python installs
# them under ~/Library/Python/<ver>/bin (not ~/.local/bin), e.g. ipython, ipdb3.
# (N) = null-glob so this is a no-op when nothing matches. Wrapped in an
# anonymous function with `emulate -L zsh` so the (N) qualifier is honored even
# if bare_glob_qual has been disabled earlier in startup (options auto-restore).
() { emulate -L zsh; for _pybin in "$HOME"/Library/Python/*/bin(N); do path+=("$_pybin"); done }
unset _pybin

# When used with the -l option, display complete time information for the file
l="-l -T"
# Aliases I don't know what they do.
alias lfi="ls -Fh $l| egrep -v '^d'"
alias lst="ls -Fht $l| grep `date +%Y-%m-%d`"
alias ldi="ls -Fh $l| egrep  '^d'"

# CD & LS aliases & common options for frequently used commands
alias la="ls -AFh"
alias lla="ls -AFh $l"
alias ll="ls -Fh $l"
alias ls="ls -Fh"

[[ -e "${HOME}/.iterm2_shell_integration.zsh" ]] && source "${HOME}/.iterm2_shell_integration.zsh"

# Setup and display splashscreen
splash_dir="${HOME}/.cli_images/splashscreens"
if [[ -d $splash_dir ]]; then
    pick=$(find "$splash_dir" -type f \( -iname '*.gif' -o -iname '*.png' -o -iname '*.jpg' \) | sort -R | head -n 1)
    [[ -n $pick ]] && ln -sfn "$pick" "${HOME}/.splashscreen"
fi
if [[ $TERM_PROGRAM = 'iTerm.app' ]] && [[ $STY = '' ]];
then
    printf '\033]1337;ClearScrollback\a'
    ${HOME}/bin/fullscreen ${HOME}/.splashscreen
    sleep $(( $(exiftool -S -Duration ${HOME}/.splashscreen | awk '{print $2}') + 0.5 ))
    printf '\033]1337;ClearScrollback\a'
fi
