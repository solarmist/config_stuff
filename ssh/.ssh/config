# NOTE: OpenSSH 9.8+ removed DSA (ssh-dss) support entirely; the old
# "+ssh-dss" re-enable lines now make ssh abort on every invocation.
# If a legacy device needs old algorithms, scope them to that Host block,
# e.g.: HostkeyAlgorithms +ssh-rsa / Ciphers +aes128-cbc
Host *
     UseKeychain yes
     AddKeysToAgent yes
     IdentityFile %d/.ssh/id_ed25519

# Only forward the agent to my own machines, not every host
Host solarmist.net solarmist.network *.solarmist.network 192.168.0.* 192.168.1.*
     ForwardAgent yes

Host 192.168.1.116
     User root

Host 192.168.0.19 pihole.solarmist.network
     User pi

Host 192.168.1.1 192.168.1.80
     User solarmist

Host solarmist.net
     User solarmist

Host unifi.solarmist.network
     User root

Host solarmist.network
     User solarmist

Host mihoshi.solarmist.network
     User solarmist
